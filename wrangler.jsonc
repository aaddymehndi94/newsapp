{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-news",
  "compatibility_date": "2026-11-01",
  // Pure static site: no Worker script, just assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
